# Copie este arquivo para .env e preencha os valores

PORT=3000
NODE_ENV=development

# URLs usadas no checkout Mercado Pago
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Painel React administrativo (origem permitida e autenticação por cookie)
ADMIN_FRONTEND_URL=http://localhost:5174
ADMIN_PASSWORD=troque_por_uma_senha_forte
ADMIN_SECRET_KEY=troque_por_um_segredo_longo_e_aleatorio
ADMIN_AUTH_ENABLED=true

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@host:porta/bancodedados"
DIRECT_URL="postgresql://usuario:senha@host:porta/bancodedados"

# Mercado Pago
MP_ACCESS_TOKEN=seu_access_token_aqui

# Taxa fixa, em reais, exibida separadamente no checkout (ex.: 5 = R$ 5,00)
TAXA_CHECKOUT=5

# Tokens administrativos
REEMBOLSO_ADMIN_TOKEN=troque_por_um_token_forte
EVENTOS_ADMIN_TOKEN=troque_por_um_token_forte_para_eventos

# Email
EMAIL_USER=seu_email@example.com
EMAIL_PASSWORD=sua_senha
EMAIL_DESTINO=organizador@example.com

# Verificacao automatica de lotes encerrados por data/capacidade
RELATORIO_LOTES_INTERVAL_MS=300000
